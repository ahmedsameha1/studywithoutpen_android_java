<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:android.support.v7.cardview="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="com.ahmedsameha1.studyvocabulary.StudyActivity"
    tools:showIn="@layout/app_bar_study">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:id="@+id/question_linearlayout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="0dp"
                android:layout_weight="1"
                android:background="@drawable/show_question_background"
                android:padding="0dp">

                <android.support.v7.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android.support.v7.cardview:cardBackgroundColor="@android:color/transparent"
                    android.support.v7.cardview:cardCornerRadius="5dp"
                    android.support.v7.cardview:cardElevation="1dp">

                    <EditText
                        android:id="@+id/question"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/text_bordered_transperant"
                        android:focusable="false"
                        android:gravity="center"
                        android:hint="@string/question"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="textNoSuggestions|textMultiLine"
                        android:minLines="1"
                        android:padding="5dp"
                        android:scrollbarAlwaysDrawVerticalTrack="true"
                        android:scrollbars="vertical"
                        android:textColor="#FFFFFF"

                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:typeface="monospace" />
                </android.support.v7.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/answer_linearlayout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="0dp"
                android:layout_weight="1"
                android:background="@drawable/enter_answer_background"
                android:padding="0dp">

                <android.support.v7.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android.support.v7.cardview:cardBackgroundColor="@android:color/transparent"
                    android.support.v7.cardview:cardCornerRadius="5dp"
                    android.support.v7.cardview:cardElevation="1dp">

                    <EditText
                        android:id="@+id/answer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:background="@drawable/text_bordered_transperant"
                        android:enabled="true"
                        android:gravity="center"
                        android:hint="@string/answer"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="textNoSuggestions|textMultiLine"
                        android:minLines="1"
                        android:padding="5dp"
                        android:scrollbarAlwaysDrawVerticalTrack="true"
                        android:textColor="#FFFFFF"

                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:typeface="monospace" />
                </android.support.v7.widget.CardView>
            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_weight="0"
            android:layout_marginBottom="5dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginTop="2dp">

            <android.support.v7.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android.support.v7.cardview:cardBackgroundColor="@android:color/transparent"
                android.support.v7.cardview:cardCornerRadius="5dp"
                android.support.v7.cardview:cardElevation="1dp"
                android.support.v7.cardview:cardPreventCornerOverlap="true">

                <TextView
                    android:id="@+id/show_actionbar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/text_bordered_colored"
                    android:gravity="center"
                    android:padding="2dp"
                    android:textColor="@drawable/textview_enabled_disabled_selector" />
            </android.support.v7.widget.CardView>

            <android.support.v7.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android.support.v7.cardview:cardBackgroundColor="@android:color/transparent"
                android.support.v7.cardview:cardCornerRadius="5dp"
                android.support.v7.cardview:cardElevation="1dp">

                <TextView
                    android:id="@+id/check"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:layout_margin="2dp"
                    android:background="@drawable/text_bordered_colored"
                    android:enabled="true"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="@string/check"
                    android:textColor="@drawable/textview_enabled_disabled_selector"
                    android:textStyle="bold" />
            </android.support.v7.widget.CardView>


            <android.support.v7.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.3"
                android.support.v7.cardview:cardBackgroundColor="@android:color/transparent"
                android.support.v7.cardview:cardCornerRadius="5dp"
                android.support.v7.cardview:cardElevation="1dp">

                <TextView
                    android:id="@+id/correct_answers"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="2dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/text_bordered_colored"
                    android:enabled="false"
                    android:gravity="center"
                    android:padding="2dp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </android.support.v7.widget.CardView>

            <android.support.v7.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android.support.v7.cardview:cardBackgroundColor="@android:color/transparent"
                android.support.v7.cardview:cardCornerRadius="5dp"
                android.support.v7.cardview:cardElevation="1dp">

                <ToggleButton
                    android:id="@+id/show_current_study_entry"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="2dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/text_bordered_colored"
                    android:checked="false"
                    android:gravity="center"
                    android:padding="2dp"
                    android:textColor="@drawable/textview_enabled_disabled_selector"
                    android:textOff="@string/show_entry"
                    android:textOn="@string/ok" />
            </android.support.v7.widget.CardView>

            <android.support.v7.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android.support.v7.cardview:cardBackgroundColor="@android:color/transparent"
                android.support.v7.cardview:cardCornerRadius="5dp"
                android.support.v7.cardview:cardElevation="1dp">

                <ImageButton
                    android:id="@+id/down"
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/text_bordered_colored"
                    android:src="@drawable/ic_arrow_drop_down_white_24dp" />

            </android.support.v7.widget.CardView>

            <android.support.v7.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android.support.v7.cardview:cardBackgroundColor="@android:color/transparent"
                android.support.v7.cardview:cardCornerRadius="5dp"
                android.support.v7.cardview:cardElevation="1dp">

                <ImageButton
                    android:id="@+id/up"
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/text_bordered_colored"
                    android:src="@drawable/ic_arrow_drop_up_white_24dp" />
            </android.support.v7.widget.CardView>
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>