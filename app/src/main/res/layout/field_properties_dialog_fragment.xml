<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingLeft="20dp"
    android:paddingEnd="20dp"
    android:paddingRight="20dp">
    <EditText
        android:id="@+id/enter_new_field_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/enter_new_field_name"
        android:layout_gravity="center"
        android:imeOptions="flagNoExtractUi"
        android:paddingLeft="7dp"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/field_type"/>
    <Spinner
        android:id="@+id/field_type_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/check_type"/>
    <Spinner
        android:id="@+id/check_type_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"/>
    <CheckBox
        android:id="@+id/read_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/read_answer"
        android:padding="3dp"/>

    <Spinner
        android:id="@+id/locales_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"/>
    <Button
        android:id="@+id/emulate_field"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>