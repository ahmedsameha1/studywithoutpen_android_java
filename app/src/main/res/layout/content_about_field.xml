<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:android.support.v7.cardview="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:showIn="@layout/app_bar_about_field">

    <LinearLayout
        android:id="@+id/number_of_entries_linearlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="3dp"
        android:padding="3dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ffff"
            android:gravity="center"/>

        <EditText
            android:id="@+id/number_of_entries"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="55"
            android:gravity="center"/>

    </LinearLayout>
    <TextView
        android:id="@+id/field_notes_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="55"
        android:gravity="center"
        android:layout_below="@id/number_of_entries_linearlayout"/>

    <ListView
        android:id="@+id/notes_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/field_notes_title"/>

</RelativeLayout>