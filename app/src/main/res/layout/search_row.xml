<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android.support.v7.cardview:cardBackgroundColor="@android:color/transparent"
    android.support.v7.cardview:cardCornerRadius="5dp"
    android.support.v7.cardview:contentPadding="5dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:android.support.v7.cardview="http://schemas.android.com/apk/res-auto">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
        <android.support.v7.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android.support.v7.cardview:cardBackgroundColor="#FFCC80"
            android.support.v7.cardview:cardCornerRadius="5dp"
            android.support.v7.cardview:cardElevation="1dp">

            <TextView
                android:id="@+id/study_search_list_view_text1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:minLines="1"
                android:padding="5dp"
                android:hint="@string/question"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textSize="15sp"
                android:typeface="monospace"
                />
        </android.support.v7.widget.CardView>



        <android.support.v7.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android.support.v7.cardview:cardBackgroundColor="#EF9A9A"
            android.support.v7.cardview:cardCornerRadius="5dp"
            android.support.v7.cardview:cardElevation="1dp">

            <TextView
                android:id="@+id/study_search_list_view_text2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:hint="@string/answer"
                android:minLines="1"
                android:padding="5dp"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textSize="15sp"
                android:textStyle="italic"
                android:typeface="monospace" />
        </android.support.v7.widget.CardView>
</LinearLayout>
   </android.support.v7.widget.CardView>

