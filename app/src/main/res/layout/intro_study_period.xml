<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/study_a_period"
        android:textSize="30sp"
        android:padding="5dp"
        android:layout_margin="10dp"
        android:id="@+id/textView"
        android:textColor="@color/colorAccent"
        android:layout_gravity="center"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/intro_study_a_period_scaled15"
            android:id="@+id/study_a_period"
            android:layout_marginStart="50dp"
            android:onClick="introImageClicked"
            android:elevation="5dp"
            />

       <ImageView
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:layout_weight="0.5"
           android:layout_gravity="center"
           android:src="@drawable/intro_arrow"/>

        <ImageView
            android:id="@+id/study_a_period_dialog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/intro_study_a_period_dialog_scaled15"
            android:layout_marginEnd="50dp"
            android:onClick="introImageClicked"
            android:elevation="5dp"
            />
    </LinearLayout>

    <EditText
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_margin="15dp"
        android:background="@null"
        android:cursorVisible="false"
        android:focusable="false"
        android:padding="5dp"
        android:text="@string/intro_study_period_text"
        android:textSize="20sp"
        android:textColor="@color/black_color"
        android:lineSpacingExtra="3dp"/>

</LinearLayout>