<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:android.support.v7.cardview="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:showIn="@layout/app_bar_emulate_field">



    <LinearLayout
        android:id="@+id/number_of_entries_linearlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="10">

        <EditText
            android:id="@+id/enter_number_of_entries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="9"
            android:gravity="center"
            android:imeOptions="flagNoExtractUi"
            android:hint="@string/enter_the_number_of__everyday_entries"
            android:inputType="number"
            />

        <ImageButton
            android:id="@+id/number_of_entries_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_help_black_24dp"
            style="@style/Widget.AppCompat.Button.Borderless"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/starting_entry_linearlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/number_of_entries_linearlayout"
        android:gravity="center"
        android:weightSum="10">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="9"
            android:gravity="center"
            android:text="@string/if_you_want_select_the_starting_entry"/>

        <ImageButton
            android:id="@+id/starting_entry_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:src="@drawable/ic_help_black_24dp"
            style="@style/Widget.AppCompat.Button.Borderless"/>
    </LinearLayout>



    <android.support.v7.widget.RecyclerView
        android:id="@+id/copy_move_entries_activity_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/starting_entry_linearlayout"/>

</RelativeLayout>