<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <Button
            android:id="@+id/sort_entry_order_asc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_by_entry_order_asc"
            android:visibility="gone"
            android:textAllCaps="false"
            style="@style/Widget.AppCompat.Button.Borderless"/>

        <Button
            android:id="@+id/sort_entry_order_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_by_entry_order_desc"
            android:visibility="gone"
            android:textAllCaps="false"
            style="@style/Widget.AppCompat.Button.Borderless"/>

        <Button
            android:id="@+id/sort_question_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_question_desc"
            android:visibility="gone"
            android:textAllCaps="false"
            style="@style/Widget.AppCompat.Button.Borderless"/>

        <Button
            android:id="@+id/sort_question_asc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_question_asc"
            android:visibility="gone"
            android:textAllCaps="false"
            style="@style/Widget.AppCompat.Button.Borderless"/>

        <Button
            android:id="@+id/sort_date_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_date_desc"
            android:visibility="gone"
            android:textAllCaps="false"
            style="@style/Widget.AppCompat.Button.Borderless"/>

        <Button
            android:id="@+id/sort_date_asc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_date_asc"
            android:visibility="gone"
            android:textAllCaps="false"
            style="@style/Widget.AppCompat.Button.Borderless"/>

        <Button
            android:id="@+id/sort_rank_asc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_by_entry_rank_asc"
            android:textAllCaps="false"
            style="@style/Widget.AppCompat.Button.Borderless"/>

        <Button
            android:id="@+id/sort_rank_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_by_entry_rank_desc"
            android:textAllCaps="false"
            style="@style/Widget.AppCompat.Button.Borderless"/>

        <Button
            android:id="@+id/sort_answer_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_answer_desc"
            android:textAllCaps="false"
            style="@style/Widget.AppCompat.Button.Borderless"/>

        <Button
            android:id="@+id/sort_answer_asc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_answer_asc"
            android:textAllCaps="false"
            style="@style/Widget.AppCompat.Button.Borderless"/>

        <Button
            android:id="@+id/sort_creation_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_creation_desc"
            android:textAllCaps="false"
            style="@style/Widget.AppCompat.Button.Borderless"/>

        <Button
            android:id="@+id/sort_creation_asc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_creation_asc"
            android:textAllCaps="false"
            style="@style/Widget.AppCompat.Button.Borderless"/>

    </LinearLayout>
</ScrollView>