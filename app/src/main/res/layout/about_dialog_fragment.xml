<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:layout_margin="3dp"
        android:padding="3dp"
        android:weightSum="2">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/version"
            android:layout_margin="3dp"/>

        <TextView
        android:id="@+id/version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
            android:layout_weight="1"
        android:gravity="center"
        android:layout_margin="3dp"/>

    </LinearLayout>


        <TextView
            android:id="@+id/terms_of_use"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:padding="3dp"
            android:layout_gravity="center"
            android:text="@string/terms_of_use"
            />

    <Button
        android:id="@+id/contact_developer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/contact_developer"/>
    <Button
        android:id="@+id/facebook"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/facebook_page"/>

    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:text="@string/collect_data_about_usage"
    android:padding="3dp"
    android:layout_margin="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_licenses"
            android:gravity="center"
            android:layout_margin="5dp"
            android:padding="5dp"/>
    <TextView
        android:id="@+id/circular_floating_action_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/CircularFloatingActionMenu"
        android:layout_margin="5dp"
        android:padding="5dp"/>
        <TextView
        android:id="@+id/android_filepicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
            android:padding="5dp"
        android:text="@string/android_filepicker"/>
        <TextView
        android:id="@+id/cwac_loaderex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cwac_loaderex"
            android:layout_margin="5dp"
            android:padding="5dp"/>
</LinearLayout>
</LinearLayout>