<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:android.support.v7.cardview="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/recycler_view_text_bordered_transperant"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <android.support.v7.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="3dp"
            android:layout_marginLeft="3dp"
            android:layout_marginTop="3dp"
            android.support.v7.cardview:cardBackgroundColor="#FFCC80"
            android.support.v7.cardview:cardCornerRadius="5dp"
            android.support.v7.cardview:cardElevation="1dp">

            <TextView
                android:id="@+id/wrong_question"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:hint="@string/question"
                android:minLines="1"
                android:padding="5dp"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textSize="15sp"
                android:typeface="monospace" />
        </android.support.v7.widget.CardView>


        <android.support.v7.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="3dp"
            android:layout_marginLeft="3dp"

            android.support.v7.cardview:cardBackgroundColor="#EF9A9A"
            android.support.v7.cardview:cardCornerRadius="5dp"
            android.support.v7.cardview:cardElevation="1dp">

            <TextView
                android:id="@+id/wrong_answer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:hint="@string/answer"
                android:minLines="1"
                android:padding="5dp"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textSize="15sp"
                android:typeface="monospace" />
        </android.support.v7.widget.CardView>
        <android.support.v7.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="3dp"
            android:layout_marginLeft="3dp"
            android:layout_marginBottom="3dp"
            android.support.v7.cardview:cardBackgroundColor="#FF0000"
            android.support.v7.cardview:cardCornerRadius="5dp"
            android.support.v7.cardview:cardElevation="1dp">
        <Spinner
            android:id="@+id/wrong_answer_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            />
    </android.support.v7.widget.CardView>
    </LinearLayout>

</LinearLayout>

