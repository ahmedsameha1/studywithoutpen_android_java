<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:android.support.v7.cardview="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:showIn="@layout/app_bar_field_information">

    <LinearLayout
        android:id="@+id/number_of_entries_linearlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="3dp"
        android:padding="3dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/number_of_entries"
            android:gravity="center"
            android:padding="2dp"/>

        <TextView
            android:id="@+id/number_of_entries"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="2dp"/>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/moderate_or_higher_entries_linearlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="3dp"
        android:padding="3dp"
        android:layout_below="@id/number_of_entries_linearlayout"
        android:weightSum="2">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/number_of_moderate_or_higher_entries"
            android:gravity="center"
            android:padding="2dp"/>

        <TextView
            android:id="@+id/moderate_or_higher_entries"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="2dp"/>

    </LinearLayout>
    <TextView
        android:id="@+id/field_notes_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/field_notes"
        android:gravity="center"
        android:layout_below="@id/moderate_or_higher_entries_linearlayout"
        android:padding="3dp"
        android:layout_margin="3dp"/>

    <ListView
        android:id="@+id/notes_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/field_notes_title"
        android:fastScrollEnabled="true"
        android:fastScrollAlwaysVisible="true"/>

</RelativeLayout>