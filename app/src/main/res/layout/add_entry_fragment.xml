<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:text="@string/add_new_entryies"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/enter_question"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="@string/enter_a_question"
                    android:imeOptions="flagNoExtractUi"/>

                <ImageButton
                    android:id="@+id/clear_question"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_gravity="bottom"
                    android:layout_weight="0"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_clear_black_24dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/enter_answer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="@string/enter_an_answer"
                    android:imeOptions="flagNoExtractUi"/>

                <ImageButton
                    android:id="@+id/clear_answer"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_weight="0"
                    android:layout_gravity="bottom"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_clear_black_24dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/save_entry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="@string/save"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/save_entry_and_clear_fields"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/save_and_clear"
                    android:textAllCaps="false" />

            </LinearLayout>
            <LinearLayout
                android:id="@+id/show_entries_button_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="center"/>
            <!--<Button
                android:id="@+id/show_entries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_entries"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:visibility="invisible"/>-->

        </LinearLayout>
    </ScrollView>

</LinearLayout>