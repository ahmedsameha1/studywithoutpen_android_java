<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fields"
        android:textSize="30sp"
        android:padding="5dp"
        android:layout_margin="5dp"
        android:id="@+id/textView"
        android:textColor="@color/colorAccent"
        android:layout_gravity="center"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/intro_main_scaled15"
            android:id="@+id/intro_main"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="30dp"
            android:onClick="introImageClicked"
            android:elevation="5dp"
            />


        <ImageView
            android:id="@+id/intro_main_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/intro_main_menu_scaled15"
            android:layout_marginEnd="50dp"
            android:layout_marginStart="30dp"
            android:onClick="introImageClicked"
            android:elevation="5dp"
            />
    </LinearLayout>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:textSize="20sp"
        android:textColor="@color/black_color"
        android:lineSpacingExtra="3dp"
        android:focusable="false"
        android:cursorVisible="false"
        android:background="@null"
        android:layout_margin="15dp"
        android:padding="5dp"
        android:text="@string/intro_main_text"
        />

</LinearLayout>