<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ahmedsameha1.studyvocabularyfive">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity
            android:name="com.ahmedsameha1.studyvocabularyfive.FieldActivity"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.ahmedsameha1.studyvocabularyfive.MainActivity"
            android:label="@string/app_name">

        </activity>
        <activity
            android:name="com.ahmedsameha1.studyvocabularyfive.StudyActivity"
            android:label="@string/app_name" />
        <activity
            android:name="com.ahmedsameha1.studyvocabularyfive.TestActivity"
            android:label="@string/app_name" />
        <activity
            android:name="com.ahmedsameha1.studyvocabularyfive.EntriesListActivity"
            android:label="@string/app_name" />
        <activity
            android:name="com.ahmedsameha1.studyvocabularyfive.WrongAnswersActivity"
            android:label="@string/app_name" />
        <activity
            android:name="com.ahmedsameha1.studyvocabularyfive.StudyDuringActivity"
            android:label="@string/app_name"
            android:screenOrientation="portrait"/>
        <activity
            android:name="com.ahmedsameha1.studyvocabularyfive.StudyWrongAnswersActivity"
            android:label="@string/app_name" />
        <activity android:name=".Dialogs.ExportSuccessfulActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Dialog"
            android:taskAffinity=""
            android:excludeFromRecents="true"/>
        <activity android:name=".Dialogs.NotImportedFieldsActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Dialog"
            android:taskAffinity=""
            android:excludeFromRecents="true"/>
        <provider
            android:name=".Database.DataProvider"
            android:authorities="com.ahmedsameha1.studyvocabularyfive.contentprovider" />

    </application>


</manifest>
