<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:android.support.v7.cardview="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="com.ahmedsameha1.peninbin.activities.EditEntryActivity"
    tools:showIn="@layout/app_bar_edit_entry">


    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="2">

        <LinearLayout
            android:id="@+id/question_linearlayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="0dp"
            android:layout_weight="1"
            android:background="@drawable/show_question_background"
            android:padding="0dp">

            <android.support.v7.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android.support.v7.cardview:cardBackgroundColor="@android:color/transparent"
                android.support.v7.cardview:cardCornerRadius="5dp"
                android.support.v7.cardview:cardElevation="1dp">

                <EditText
                    android:id="@+id/question"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/text_bordered_transperant"
                    android:gravity="center"
                    android:hint="@string/enter_a_question"
                    android:imeOptions="flagNoExtractUi"
                    android:inputType="textNoSuggestions|textVisiblePassword|textMultiLine"
                    android:minLines="1"
                    android:padding="5dp"
                    android:scrollbarAlwaysDrawVerticalTrack="true"
                    android:scrollbars="vertical"
                    android:textColor="#FFFFFF"

                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:typeface="monospace"
                    android:layout_weight="1"
                    android:ellipsize="none"
                    android:maxLines="1000"
                    android:scrollHorizontally="false"/>
            </android.support.v7.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/answer_linearlayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="0dp"
            android:layout_weight="1"
            android:background="@drawable/show_question_background"
            android:padding="0dp">

            <android.support.v7.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android.support.v7.cardview:cardBackgroundColor="@android:color/transparent"
                android.support.v7.cardview:cardCornerRadius="5dp"
                android.support.v7.cardview:cardElevation="1dp">

                <EditText
                    android:id="@+id/answer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/text_bordered_transperant"
                    android:enabled="true"
                    android:gravity="center"
                    android:hint="@string/enter_an_answer"
                    android:imeOptions="flagNoExtractUi"
                    android:inputType="textNoSuggestions|textVisiblePassword|textMultiLine"
                    android:minLines="1"
                    android:padding="5dp"
                    android:scrollbarAlwaysDrawVerticalTrack="true"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:typeface="monospace"
                    android:layout_weight="1"
                    android:ellipsize="none"
                    android:maxLines="1000"
                    android:scrollHorizontally="false"/>
            </android.support.v7.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="5dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginTop="2dp"
            android:layout_weight="3">

            <android.support.v7.widget.CardView
                android:id="@+id/show_actionbar_card_view"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android.support.v7.cardview:cardBackgroundColor="@android:color/transparent"
                android.support.v7.cardview:cardCornerRadius="5dp"
                android.support.v7.cardview:cardElevation="1dp"
                android.support.v7.cardview:cardPreventCornerOverlap="true">

                <TextView
                    android:id="@+id/show_actionbar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/text_bordered_colored"
                    android:gravity="center"
                    android:padding="2dp"
                    android:textColor="@drawable/textview_enabled_disabled_selector" />
            </android.support.v7.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:orientation="horizontal">

                <android.support.v7.widget.CardView
                    android:id="@+id/order_card_view"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android.support.v7.cardview:cardBackgroundColor="@android:color/transparent"
                    android.support.v7.cardview:cardCornerRadius="5dp"
                    android.support.v7.cardview:cardElevation="1dp">

                    <EditText
                        android:id="@+id/order"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:imeOptions="flagNoExtractUi"
                        android:scrollHorizontally="true"
                        android:inputType="number"
                        android:hint="@string/order"
                        android:background="@null"/>

                </android.support.v7.widget.CardView>
                <android.support.v7.widget.CardView
                    android:id="@+id/rank_card_view"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android.support.v7.cardview:cardBackgroundColor="@android:color/transparent"
                    android.support.v7.cardview:cardCornerRadius="5dp"
                    android.support.v7.cardview:cardElevation="1dp">

                    <Spinner
                        android:id="@+id/rank_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                </android.support.v7.widget.CardView>
            </LinearLayout>

            <android.support.v7.widget.CardView
                android:id="@+id/save_card_view"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android.support.v7.cardview:cardBackgroundColor="@android:color/transparent"
                android.support.v7.cardview:cardCornerRadius="5dp"
                android.support.v7.cardview:cardElevation="1dp">

                <TextView
                    android:id="@+id/save"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:background="@drawable/text_bordered_colored"
                    android:enabled="true"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="@string/save"
                    android:textColor="@drawable/textview_enabled_disabled_selector"
                    android:textStyle="bold" />
            </android.support.v7.widget.CardView>


        </LinearLayout>

    </LinearLayout>

</RelativeLayout>